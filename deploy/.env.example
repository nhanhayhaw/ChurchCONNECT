# ---------------------------------------------------------------------------
# RT AG Connect - production environment
#
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit .env. Never reuse these values between churches.
# ---------------------------------------------------------------------------

# The domain this church will use. Caddy requests a certificate for exactly
# this name, so the DNS A record must already point here before you start.
DOMAIN=church.example.org

# --- Database ---------------------------------------------------------------
# Generate the password; do not invent one:
#   openssl rand -base64 30
POSTGRES_USER=churchconnect
POSTGRES_PASSWORD=CHANGE_ME_generated_password
POSTGRES_DB=churchconnect

# --- Security ---------------------------------------------------------------
# Two DIFFERENT secrets. Generate each separately:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_64_plus_random_hex_characters
JWT_REFRESH_SECRET=CHANGE_ME_a_different_64_plus_random_hex_string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Requests per minute allowed from ONE IP address across the whole API. A
# church taking attendance from many phones on one Wi-Fi network shares a
# single public address, so size this for the busiest Sunday, not for one user.
API_RATE_LIMIT_PER_MINUTE=300

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=3145728

# --- Outbound email ---------------------------------------------------------
# Enables self-service password reset. Leave SMTP_HOST blank and the system
# still works - reset links go to the server log and an administrator resets
# passwords by hand - but expect that to become your most common support call.
#
# Verify before handing the system over:
#   docker compose run --rm app npm run email:test:prod -- you@example.com
#
# Provider choice, and the SPF/DKIM/DMARC records that keep mail out of spam:
#   docs/EMAIL.md

SMTP_HOST=
# 587 needs SMTP_SECURE=false (STARTTLS). 465 needs SMTP_SECURE=true.
# Mismatching these two is the most common cause of failure.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Must be at a domain you control and have added SPF/DKIM records for.
MAIL_FROM="RT AG Connect <no-reply@yourdomain.org>"
MAIL_REPLY_TO=

RESET_TOKEN_TTL_MINUTES=60

# --- Scheduled jobs ---------------------------------------------------------
ENABLE_JOBS=true
ABSENCE_JOB_CRON=30 1 * * *
BIRTHDAY_JOB_CRON=0 6 * * *
# Set to the church's own timezone - the nightly scan and the birthday job run
# against local time, and getting this wrong shifts both by hours.
TZ=Africa/Accra

# --- Seeding ----------------------------------------------------------------
# Only used if you run seed:prod, which you should NOT do on a real church's
# installation - it loads 62 fictional demo members.
# The quotes are required: dotenv treats an unquoted '#' as a comment.
SEED_DEFAULT_PASSWORD="CHANGE_ME_before_any_demo"
