# RT AG Connect reverse proxy and static host.
#
# {$DOMAIN} comes from the environment (set in deploy/.env). With a real domain
# Caddy obtains and renews a Let's Encrypt certificate automatically; with the
# default `localhost` it serves plain HTTP for local testing.

{$DOMAIN:localhost} {
	encode zstd gzip

	# --- API ---------------------------------------------------------------
	# Member photographs are streamed through /api/members/photos/:id rather
	# than served as static files, so they are covered by this rule and remain
	# behind authentication.
	handle /api/* {
		reverse_proxy app:4000 {
			# Lets Express see the real client IP. The API trusts exactly one
			# proxy hop in production, so rate limiting and audit logging
			# record the visitor rather than the container.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# --- Client ------------------------------------------------------------
	handle {
		root * /srv

		# Hashed asset filenames are immutable; cache them hard.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# index.html must never be cached, or users keep an old app shell after
		# a deploy and load asset files that no longer exist.
		header /index.html Cache-Control "no-cache"

		# Single-page app: unknown paths are client routes, not 404s.
		try_files {path} /index.html
		file_server
	}

	# --- Security headers ---------------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Access logs go to stdout, where `docker compose logs` can reach them.
	log {
		output stdout
		format console
	}
}
