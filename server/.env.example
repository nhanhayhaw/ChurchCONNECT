# ---------------------------------------------------------------------------
# ChurchConnect API configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public origin of the React client. Used for CORS and password-reset links.
CLIENT_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# This application talks to PostgreSQL directly through the `pg` driver. Any
# PostgreSQL 14+ server will do, hosted or local. Set DATABASE_URL and PGSSL to
# match whichever you are using.
#
# OPTION A - local PostgreSQL (the default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/churchconnect
PGSSL=false
#
# OPTION B - Supabase (hosted PostgreSQL)
# Dashboard > Connect > "Session pooler". Full walkthrough: docs/SUPABASE.md
#
#   DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
#   PGSSL=true
#
# Three things go wrong here more often than anything else:
#
#   1. Use the SESSION pooler on port 5432, not the Transaction pooler on 6543.
#      This server sets statement_timeout and idle_in_transaction_session_timeout
#      as connection parameters and holds multi-statement transactions; the
#      transaction pooler supports neither.
#   2. Do not use the "Direct connection" host (db.<ref>.supabase.co). It
#      resolves to IPv6 only, which most home and office networks cannot reach.
#   3. Percent-encode any punctuation in the password, because it sits inside a
#      URL. @ becomes %40, # becomes %23, / becomes %2F, : becomes %3A.
#      A raw @ silently truncates the host and you get a confusing DNS error.
#
# PGSSL=true is required for Supabase and for most hosted PostgreSQL.

# --- Security --------------------------------------------------------------
# Generate strong, DIFFERENT secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Account lockout after repeated failed logins
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- File uploads ----------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=3145728          # 3 MB

# --- Outbound email ---------------------------------------------------------
# Optional. Leave SMTP_HOST blank and the system still runs: password reset
# links are written to the server log and a Super Administrator can reset
# passwords by hand. Fill these in to enable self-service password reset.
#
# Verify with:  npm run email:test -- you@example.com
# Full setup guide, including SPF/DKIM/DMARC:  docs/EMAIL.md

SMTP_HOST=
# 587 with STARTTLS is the usual choice. Use 465 with SMTP_SECURE=true for
# implicit TLS. Mismatching these two is the most common cause of failure.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Must be an address at a domain you control and have authorised, or the mail
# lands in spam. Quotes are needed because the value contains a comma.
MAIL_FROM="ChurchConnect <no-reply@yourdomain.org>"
# Where replies go, if you want them to reach a human.
MAIL_REPLY_TO=

# How long a password reset link stays valid.
RESET_TOKEN_TTL_MINUTES=60

# --- Scheduled jobs (node-cron, server local time) --------------------------
ENABLE_JOBS=true
# Nightly at 01:30 - recompute absence streaks, raise alerts.
ABSENCE_JOB_CRON=30 1 * * *
# Every morning at 06:00 - generate birthday reminders.
BIRTHDAY_JOB_CRON=0 6 * * *
TZ=Africa/Accra

# --- Seeding ---------------------------------------------------------------
# Password given to every demo account created by `npm run seed`.
# NOTE: the quotes are required. dotenv treats an unquoted '#' as the start of
# an inline comment, which would silently truncate this to "ChurchConnect".
SEED_DEFAULT_PASSWORD="ChurchConnect#2026"

# --- Reverse proxies ---------------------------------------------------------
# Production only. Number of trusted proxy hops in front of the API: 1 for a
# platform router alone (Render, Railway), 2 when a CDN rewrite such as
# Vercel's /api/* proxy sits in front of it. Ignored in development.
TRUST_PROXY=1

# --- Database pool -------------------------------------------------------------
# Max simultaneous connections from this process. Supabase free tier allows 15
# per project in session mode, shared by every client; set 8 there. Local
# PostgreSQL defaults to 100, so 20 is fine locally.
DB_POOL_MAX=20

# --- Member photographs --------------------------------------------------------
# Leave blank and photos are written to UPLOAD_DIR on this machine's disk.
# Set both and they go to a private Supabase Storage bucket instead, created on
# first boot, so they survive restarts and redeploys. Dashboard -> Settings ->
# API: "Project URL" and the "service_role" secret key (server only, never the
# browser). The bucket name is optional.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=member-photos
